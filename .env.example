# OneHealth ID (OH-ID) Enterprise - Environment Configuration Template
# Copy this file to .env and supply your environment-specific credentials.

# PostgreSQL Connection String (Supabase / RDS / Cloud SQL)
DATABASE_URL=postgresql://user:password@localhost:5432/postgres
DB_SCHEMA=oh_id

# Cryptographic Secret Key for JWT Signing (Min 32 characters / 256 bits)
SECRET_KEY=change-me-to-a-cryptographically-secure-random-secret-key-32-chars

# JWT Algorithm & Expiration
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Environment Mode
ENVIRONMENT=development
