# OneHealth ID (OH-ID) Mobile Application Environment Configuration
# Copy this file to .env or .env.local for local overrides.
# DO NOT COMMIT SECRETS OR PRIVATE KEYS TO THIS FILE OR TO VERSION CONTROL.

# Backend FastAPI Gateway URL (Defaulting to production or staging endpoint)
EXPO_PUBLIC_API_URL=https://ohid.online/api/v1

# Application Environment Mode: 'development' | 'staging' | 'production'
EXPO_PUBLIC_APP_ENV=development

# Application Identifiers
EXPO_PUBLIC_APP_SCHEME=ohid
EXPO_PUBLIC_APP_ID=com.sathus.ohid
