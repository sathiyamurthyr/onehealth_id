{
  "expo": {
    "name": "OneHealth ID",
    "slug": "ohid-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "ohid",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ohid.health",
      "infoPlist": {
        "NSCameraUsageDescription": "OneHealth ID requires camera access to scan patient Zero-Knowledge QR passes for OPD check-in and clinical intake.",
        "NSFaceIDUsageDescription": "OneHealth ID uses biometric authentication to securely unlock your digital health identity and clinical workstation."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0f172a"
      },
      "package": "com.ohid.health",
      "versionCode": 2,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "OneHealth ID requires camera access to scan patient Zero-Knowledge QR passes."
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow OneHealth ID to use Face ID for biometric authentication."
        }
      ],
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "c950962b-85f8-46db-85b1-7f930875a272"
      }
    }
  }
}
