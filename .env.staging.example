# OneHealth ID (OH-ID) — Staging Environment Configuration Template
# Strictly use placeholders. Never commit plaintext production credentials or private keys.

# Core Application Environment
ENVIRONMENT=staging
PROJECT_NAME="OneHealth ID (OH-ID) Enterprise Hospital Operating System"
VERSION=1.0.0
API_V1_STR=/api/v1

# Staging Database Configuration (PostgreSQL 15+)
# Must connect to an isolated staging database instance; NEVER production.
DATABASE_URL=postgresql://<STAGING_DB_USER>:<STAGING_DB_PASSWORD>@<STAGING_DB_HOST>:5432/<STAGING_DB_NAME>
DB_SCHEMA=oh_id

# Security & Session Authentication
# Must be generated with cryptographically secure PRNG (e.g., openssl rand -hex 32)
SECRET_KEY=<STAGING_CRYPTOGRAPHICALLY_SECURE_SECRET_MIN_32_CHARS>
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Single-Facility Tenant Isolation Policy
# Strictly false to enforce hospital boundary security unless authorized
ENABLE_CROSS_HOSPITAL_SHARING=false

# Key Management Service (KMS) & Envelope Encryption
# Options: 'aws_kms' (production/staging managed KMS), 'mock_cloud_kms', 'local'
KMS_PROVIDER=aws_kms
KMS_KEY_ARN=arn:aws:kms:ap-south-1:<AWS_ACCOUNT_ID>:key/<KMS_KEY_UUID>
DOC_ENCRYPTION_KEY_ID=arn:aws:kms:ap-south-1:<AWS_ACCOUNT_ID>:key/<KMS_KEY_UUID>

# Distributed Rate Limiting & Session Revocation (Dedicated Staging Redis)
# Supports rediss:// for TLS-encrypted Redis in-transit communication
REDIS_URL=rediss://:<STAGING_REDIS_AUTH_TOKEN>@<STAGING_REDIS_HOST>:6379/0
REDIS_ENABLED=true
RATE_LIMIT_ENABLED=true
RATE_LIMIT_FAIL_POLICY=strict

# Anti-Malware Streaming Inspection (ClamAV Daemon)
CLAMAV_HOST=<STAGING_CLAMAV_DAEMON_HOST>
CLAMAV_PORT=3310
CLAMAV_ENABLED=true
MALWARE_SCAN_FAIL_POLICY=fail_closed

# Outbound Communications (Staging Mock / Isolated Sandbox)
TESTING_EMAIL_BACKEND=true
SMTP_HOST=<STAGING_SMTP_RELAY_HOST>
SMTP_PORT=587
SMTP_USER=<STAGING_SMTP_USERNAME>
SMTP_PASSWORD=<STAGING_SMTP_PASSWORD>
SMTP_FROM_EMAIL=noreply-staging@ohid.online
SMTP_FROM_NAME="OneHealth ID Staging Security"
SMTP_TLS=true
SUPER_ADMIN_SUPPORT_EMAIL=security-staging@ohid.online
